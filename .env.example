NODE_ENV=development
POSTGRES_URL=postgresql://searchforge:searchforge@postgres:5432/searchforge
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=searchforge
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=searchforge
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-secret
API_KEY_PEPPER=replace-with-random-pepper
WEB_ORIGIN=http://localhost
API_ORIGIN=http://localhost:4000
CRAWLER_USER_AGENT=SearchForgeBot/1.0 (+https://searchforge.dev/bot)
CRAWLER_ALLOW_PRIVATE_NETWORKS=false
PUBLIC_WEB_URL=http://localhost
SMTP_URL=smtp://mailpit:1025
COMPOSE_PROFILES=development
MAIL_FROM=SearchForge <no-reply@example.com>

# Optional OTLP/HTTP tracing. With the observability profile use http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=searchforge-api
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_EXPORT_TIMEOUT_MS=2000
GIT_SHA=

# Container stack is served through Caddy; public API defaults to the same origin.
NEXT_PUBLIC_API_URL=
SEARCHFORGE_DOMAIN=:80
POSTGRES_PASSWORD=searchforge
GRAFANA_ADMIN_PASSWORD=change-me
INDEX_STORAGE_PATH=/data/indexes
