{$SEARCHFORGE_DOMAIN::80} {
  encode zstd gzip

  @api path /api/* /v1/* /health*
  handle @api {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy web:3000
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
}
